From 0123456789abcdef Mon Sep 17 00:00:00 2001
From: Example <example@example.com>
Subject: [PATCH] improve greeting and add a readme

Keep the greeting readable, including 中文 and <HTML-like> text.
This message is preserved above the diff.

---
diff --git a/src/greeting.ts b/src/greeting.ts
index 1234567..89abcde 100644
--- a/src/greeting.ts
+++ b/src/greeting.ts
@@ -1,4 +1,5 @@
 export function greet(name: string) {
-  const message = 'Hello ' + name;
+  const message = `你好，${name}`;
+  const label = '<strong>Welcome & enjoy</strong>';
   return message;
 }
@@ -20,2 +21,2 @@ export const punctuation = [
--- old punctuation
+++ new punctuation
 ];
diff --git a/README.md b/README.md
new file mode 100644
--- /dev/null
+++ b/README.md
@@ -0,0 +1,3 @@
+# Demo
+
+This is a new file, with a deliberately long line to verify horizontal scrolling without wrapping: alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega.
diff --git a/old.txt b/old.txt
deleted file mode 100644
--- a/old.txt
+++ /dev/null
@@ -1 +0,0 @@
-obsolete
\ No newline at end of file
diff --git a/old-name.txt b/new-name.txt
similarity index 100%
rename from old-name.txt
rename to new-name.txt
diff --git a/icon.png b/icon.png
Binary files a/icon.png and b/icon.png differ
