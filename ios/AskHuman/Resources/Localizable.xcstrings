    "%@ did not answer. Try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应，请重试。"
          }
        }
      }
    },
    "%@ is not reachable right now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暂时连不上。"
          }
        }
      }
    },
    "%@ is not reachable. Its sessions are hidden until it is back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暂时连不上，恢复前不会显示它的会话。"
          }
        }
      }
    },
    "%@ is not reachable. Its todos show up here when it is back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暂时连不上，恢复后它的待办会显示在这里。"
          }
        }
      }
    },
    "%@ is not reachable. This is the last state it reported." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 暂时连不上，以下是它最后一次报告的状态。"
          }
        }
      }
    },
    "%@ is offline. Its requests cannot be answered until it is back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已离线，在它恢复前无法回答它的请求。"
          }
        }
      }
    },
    "%@ needs Max. Turn on Allow Max, or choose another model." : {
