    "This phone still holds %lld pairing(s) from before AskHuman was reinstalled. Keep using them, or start fresh?": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This phone still holds %lld pairing from before AskHuman was reinstalled. Keep using it, or start fresh?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This phone still holds %lld pairings from before AskHuman was reinstalled. Keep using them, or start fresh?"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机上还保留着 AskHuman 重装前的 %lld 个配对。继续使用它们，还是重新开始？"
          }
        }
      }
    },
    "This phone's clock differs too much from a Mac's, so some messages are ignored. Check Date & Time in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机的时间与 Mac 相差过大，部分消息会被忽略。请检查“设置”中的日期与时间。"
          }
        }
      }
    },
    "This removes every Mac and the broker account from this phone. Your Macs are told, and you can pair again at any time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从这部手机移除所有 Mac 和 Broker 账号。你的 Mac 会收到通知，你随时可以重新配对。"
          }
        }
      }
    },
