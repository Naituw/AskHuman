    "That TODO is gone from the Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那条 TODO 已不在 Mac 上。"
          }
        }
      }
    },
    "That effort is not available for the chosen model. Open the form again and choose another." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选模型不支持这个强度。请重新打开表单并另选一个。"
          }
        }
      }
    },
    "That file is too large (limit 10 MB)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
