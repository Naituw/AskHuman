    "That message is too long." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息太长了。"
          }
        }
      }
    },
    "That model needs Max, which this task does not allow. Turn on Allow Max or choose another model." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该模型需要 Max，而本次任务不允许使用 Max。请打开「允许 Max」或换一个模型。"
          }
        }
      }
    },
    "That speed is no longer available on the Mac. Open the form again and choose another." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 已不支持所选速度，请重新打开表单选择。"
          }
        }
      }
    },
    "That todo is too long." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条待办太长了。"
          }
        }
      }
    },
    "That todo was already handled elsewhere. The list is up to date now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条待办已在别处处理，列表已更新。"
          }
        }
      }
    },
    "The Agent asks before it acts, as its own settings say." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 会按它自己的设置在行动前询问。"
          }
        }
      }
    },
    "The Agent asks you before it runs commands or changes files." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 运行命令或修改文件前会先问你。"
          }
        }
      }
    },
    "The Agent cancelled it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 已取消它。"
          }
        }
      }
    },
    "The Agent could not be started." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动 Agent。"
          }
        }
      }
    },
    "The Agent ended this turn with an error." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 因错误结束了本轮运行。"
          }
        }
      }
    },
    "The Agent has not reported in" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 尚未报到"
          }
        }
      }
    },
    "The Agent is not ready on the Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 上的这个 Agent 还没准备好。"
          }
        }
      }
    },
    "The Agent is not working right now. Messages can only be sent while it works." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 现在没有在工作。只有它工作时才能发消息。"
          }
        }
      }
    },
    "The Agent is running." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 正在运行。"
          }
        }
      }
    },
    "The Agent is told that you cancelled." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会告知 Agent 你已取消。"
          }
        }
      }
    },
    "The Agent on the Mac no longer offers that model. Open the form again and choose another." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 上的 Agent 已不再提供这个模型。请重新打开表单并另选一个。"
          }
        }
      }
    },
    "The Agent reached its run limit." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 已达到本轮运行上限。"
          }
        }
      }
    },
    "The Agent read your message." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 已读取你的消息。"
          }
        }
      }
    },
    "The Agent reads them at its next step. Until then you can edit or withdraw them." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 会在下一步读取它们。在此之前你可以修改或撤回。"
          }
        }
      }
    },
    "The Agent receives the default response, usually a refusal." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 会收到默认回应，通常是拒绝。"
          }
        }
      }
    },
    "The Agent runs commands and changes files without asking. Use it only for tasks you trust." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 会不经询问直接运行命令、修改文件。仅用于你信任的任务。"
          }
        }
      }
    },
    "The Agent says everything is done." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 表示已全部完成。"
          }
        }
      }
    },
    "The Agent says it cannot go on without you." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 表示无法继续推进，需要你处理。"
          }
        }
      }
    },
    "The Agent starts on your Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 会在你的 Mac 上启动。"
          }
        }
      }
    },
    "The Agent stopped because it was not making progress." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 因无法继续推进而停止。"
          }
        }
      }
    },
    "The Mac" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac"
          }
        }
      }
    },
    "The Mac could not open a terminal for the Agent." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 无法为 Agent 打开终端。"
          }
        }
      }
    },
    "The Mac could not save that." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 没能保存这次修改。"
          }
        }
      }
    },
    "The Mac did not accept this task." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 没有接受这个任务。"
          }
        }
      }
    },
    "The Mac did not answer" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 没有响应"
          }
        }
      }
    },
    "The Mac did not answer in time." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 未及时响应。"
          }
        }
      }
    },
    "The Mac did not answer in time. Make sure AskHuman is running on it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 未及时响应，请确认它上面的 AskHuman 正在运行。"
          }
        }
      }
    },
    "The Mac did not answer. This is the last state it reported." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 没有响应，以下是它最后一次报告的状态。"
          }
        }
      }
    },
    "The Mac did not answer. Try again when it is online." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 没有响应，上线后再试。"
          }
        }
      }
    },
    "The Mac did not confirm it. You can send it again or discard it and edit your answer." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 没有确认收到。你可以重新发送，或放弃后修改回答。"
          }
        }
      }
    },
    "The Mac did not confirm that. The list shows what it has now." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 没有确认这次修改，列表显示的是它现在的内容。"
          }
        }
      }
    },
    "The Mac is offline. Try again when it is back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 已离线，请在它恢复后重试。"
          }
        }
      }
    },
    "The Mac is offline. Your draft is kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 已离线，草稿已保留。"
          }
        }
      }
    },
    "The Mac is offline. Your draft is kept; try again when it is back." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 已离线，草稿已保留，请在它恢复后重试。"
          }
        }
      }
    },
    "The Mac is told, and its keys are removed from this phone. You can pair again at any time." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会通知这台 Mac，并从这部手机移除它的密钥。你随时可以重新配对。"
          }
        }
      }
    },
    "The Mac no longer has this session." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 上已没有这个会话。"
          }
        }
      }
    },
    "The Mac no longer lists this session." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 已不再列出这个会话。"
          }
        }
      }
    },
    "The Mac refused it (%@)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 拒绝了它（%@）。"
          }
        }
      }
    },
    "The Mac refused the pairing." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 拒绝了这次配对。"
          }
        }
      }
    },
    "The broker could not be reached. Check your network and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 Broker，请检查网络后重试。"
          }
        }
      }
    },
    "The broker refused the connection. Its settings may have changed, or this month's free data allowance may be used up. Check on your Mac, then pair again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broker 拒绝了连接。可能是它的设置变了，也可能是本月的免费流量额度已用完。请在 Mac 上检查，然后重新配对。"
          }
        }
      }
    },
    "The broker refused the credentials in the code." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broker 拒绝了配对码中的凭据。"
          }
        }
      }
    },
    "The code works once and expires after five minutes. Your Mac asks you to confirm before anything is shared." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配对码只能使用一次，五分钟后失效。在共享任何内容之前，Mac 会请你确认。"
          }
        }
      }
    },
    "The connection dropped. The Mac may or may not have received the task." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接中断了。Mac 不一定收到了这个任务。"
          }
        }
      }
    },
    "The file could not be read." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取该文件。"
          }
        }
      }
    },
    "The message may have been sent. Check the original chat before sending another message." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息可能已经发送。再次发送前，请先检查原聊天。"
          }
        }
      }
    },
    "The name is only changed on this phone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称只在这部手机上修改。"
          }
        }
      }
    },
    "The name your Macs show for this phone. It applies to pairings you make from now on." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 上显示的这部手机的名称，仅对之后的配对生效。"
          }
        }
      }
    },
    "The original Agent is unavailable or does not support this action." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原 Agent 不可用，或尚不支持此操作。"
          }
        }
      }
    },
    "The pairing code has expired. Create a new one on the Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配对码已过期，请在 Mac 上重新生成。"
          }
        }
      }
    },
    "The pairing was cancelled on the Mac." : {
      "localizations" : {
        "zh-Hans" : {
