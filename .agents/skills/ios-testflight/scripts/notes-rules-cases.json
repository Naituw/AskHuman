{
  "about": "Shared contract for the TestFlight notes rules. NotesRules.swift (compiled into the helper) and helper.py (the launcher) must both reproduce every case; scripts/ios-testflight-changes.node-test.mjs runs both. A value of the form {\"$repeat\": text, \"$count\": n} stands for text repeated n times, with an optional \"$suffix\" appended. An error is the rejection reason code.",
  "canonicalize": [
    { "name": "keeps ordinary text unchanged", "input": "Build 7 · source abc1234\n\n• one\n• two", "expect": "Build 7 · source abc1234\n\n• one\n• two" },
    { "name": "normalizes CRLF and CR to LF", "input": "a\r\nb\rc", "expect": "a\nb\nc" },
    { "name": "strips the trailing run of spaces and newlines", "input": "a\n\n  \n", "expect": "a" },
    { "name": "keeps a leading blank line and trailing spaces inside lines", "input": "\n a  \nb", "expect": "\n a  \nb" },
    { "name": "keeps non-ASCII trailing whitespace", "input": "a\u00a0\u3000", "expect": "a\u00a0\u3000" },
    { "name": "keeps CJK, bullets and emoji", "input": "构建 7 · 源码 abc1234\n• 新增 😀", "expect": "构建 7 · 源码 abc1234\n• 新增 😀" },
    { "name": "4000 ASCII characters fit", "input": { "$repeat": "a", "$count": 4000 }, "expect": { "$repeat": "a", "$count": 4000 } },
    { "name": "4001 ASCII characters are too long", "input": { "$repeat": "a", "$count": 4001 }, "error": "tooLong" },
    { "name": "length is measured after stripping", "input": { "$repeat": "a", "$count": 4000, "$suffix": "\n\n   " }, "expect": { "$repeat": "a", "$count": 4000 } },
    { "name": "2000 emoji are exactly 4000 UTF-16 units", "input": { "$repeat": "😀", "$count": 2000 }, "expect": { "$repeat": "😀", "$count": 2000 } },
    { "name": "2001 emoji are too long", "input": { "$repeat": "😀", "$count": 2001 }, "error": "tooLong" },
    { "name": "rejects a tab", "input": "a\tb", "error": "control" },
    { "name": "rejects NUL", "input": "a\u0000b", "error": "control" },
    { "name": "rejects ESC", "input": "\u001b[31mred", "error": "control" },
    { "name": "rejects DEL", "input": "a\u007fb", "error": "control" },
    { "name": "whitespace only is empty", "input": " \n  \n", "error": "empty" },
    { "name": "empty string is empty", "input": "", "error": "empty" }
  ],
  "build": [
    { "value": "7", "ok": true },
    { "value": "10", "ok": true },
    { "value": "123456789", "ok": true },
    { "value": "1234567890", "ok": false },
    { "value": "0", "ok": false },
    { "value": "07", "ok": false },
    { "value": "", "ok": false },
    { "value": " 7", "ok": false },
    { "value": "7 ", "ok": false },
    { "value": "7\n", "ok": false },
    { "value": "-7", "ok": false },
    { "value": "7a", "ok": false },
    { "value": "\u0667", "ok": false }
  ],
  "request": [
    { "name": "read", "request": { "mode": "read", "build": "6" }, "expect": { "mode": "read", "build": "6", "texts": {} } },
    { "name": "probe", "request": { "mode": "probe", "build": "6" }, "expect": { "mode": "probe", "build": "6", "texts": {} } },
    { "name": "write both locales, canonicalizing each text", "request": { "mode": "write", "build": "7", "texts": { "zh-Hans": "构建 7\r\n• 新增  \n", "en-US": "Build 7\n• Added" } }, "expect": { "mode": "write", "build": "7", "texts": { "zh-Hans": "构建 7\n• 新增", "en-US": "Build 7\n• Added" } } },
    { "name": "write one locale", "request": { "mode": "write", "build": "7", "texts": { "en-US": "Build 7" } }, "expect": { "mode": "write", "build": "7", "texts": { "en-US": "Build 7" } } },
    { "name": "mode is missing", "request": { "build": "6" }, "error": "badMode" },
    { "name": "mode is not a string", "request": { "mode": 1, "build": "6" }, "error": "badMode" },
    { "name": "mode is unknown", "request": { "mode": "delete", "build": "6" }, "error": "badMode" },
    { "name": "build is a number", "request": { "mode": "read", "build": 6 }, "error": "badBuild" },
    { "name": "build is missing", "request": { "mode": "read" }, "error": "badBuild" },
    { "name": "build has a leading zero", "request": { "mode": "read", "build": "06" }, "error": "badBuild" },
    { "name": "unknown field", "request": { "mode": "read", "build": "6", "extra": 1 }, "error": "badRequest" },
    { "name": "request is not an object", "request": [], "error": "badRequest" },
    { "name": "read must not carry texts", "request": { "mode": "read", "build": "6", "texts": {} }, "error": "badRequest" },
    { "name": "probe must not carry texts", "request": { "mode": "probe", "build": "6", "texts": { "en-US": "x" } }, "error": "badRequest" },
    { "name": "write needs texts", "request": { "mode": "write", "build": "6" }, "error": "badRequest" },
    { "name": "write texts must be an object", "request": { "mode": "write", "build": "6", "texts": "x" }, "error": "badRequest" },
    { "name": "write texts must not be empty", "request": { "mode": "write", "build": "6", "texts": {} }, "error": "badRequest" },
    { "name": "write rejects an unlisted locale", "request": { "mode": "write", "build": "6", "texts": { "ja": "x" } }, "error": "badLocale" },
    { "name": "locale matching is case-sensitive", "request": { "mode": "write", "build": "6", "texts": { "zh-hans": "x" } }, "error": "badLocale" },
    { "name": "write text must be a string", "request": { "mode": "write", "build": "6", "texts": { "en-US": 5 } }, "error": "badRequest" },
    { "name": "write rejects control characters", "request": { "mode": "write", "build": "6", "texts": { "en-US": "a\tb" } }, "error": "control" },
    { "name": "write rejects empty text", "request": { "mode": "write", "build": "6", "texts": { "en-US": "  " } }, "error": "empty" },
    { "name": "write rejects overlong text", "request": { "mode": "write", "build": "6", "texts": { "en-US": { "$repeat": "a", "$count": 4001 } } }, "error": "tooLong" }
  ]
}
